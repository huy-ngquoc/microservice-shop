# Line endings
* text=auto eol=lf

*.jar binary
*.class binary

*.h5 binary
*.pth binary
*.pt binary
*.onnx binary

# ML model weights live in Git LFS. Scoped to ml-service so a stray weight file
# elsewhere is not silently pulled into LFS.
backend/ml-service/*.h5 filter=lfs diff=lfs merge=lfs -text
backend/ml-service/*.pth filter=lfs diff=lfs merge=lfs -text
