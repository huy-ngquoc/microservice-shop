# Sample environment for MSShop — copy to `.env` and fill in the secrets:
#   cp .env.example .env
# Non-secret values below target the Docker Compose network (container hostnames + internal ports).
# Entries marked CHANGE-ME are account-specific secrets — never commit real values.

# ── Config server & service discovery ──
CONFIG_SERVER_URL=http://config-server:8888
DISCOVERY_SERVER_URL=http://discovery-server:8761/eureka/

# ── Messaging & tracing ──
KAFKA_URL=ms_kafka:9092
ZIPKIN_URL=http://ms_zipkin:9411/api/v2/spans

# ── Keycloak (OIDC) ──
KEYCLOAK_URL=ms-keycloak:8080
KEYCLOAK_REALM=ms_shop
KEYCLOAK_CLIENT_ID=ms_shop_rest_api
KEYCLOAK_CLIENT_SECRET=CHANGE-ME
KEYCLOAK_CLIENT_UUID=CHANGE-ME

# ── PostgreSQL (host:port inside the Compose network) ──
ACCOUNT_DB_URL=ms_pg_sql_account:5432
INVENTORY_DB_URL=ms_pg_sql_inventory:5432
PAYMENT_DB_URL=ms_pg_sql_payment:5432

# ── MongoDB (host:port inside the Compose network) ──
PRODUCT_DB_HOST=ms_mongo_db
PRODUCT_DB_PORT=27017
CART_MONGODB_URL=mongodb_cart:27017
ORDER_DB_URL=ms_mongo_db_order:27017
NOTIFICATION_DB_URL=ms_mongo_db_notification:27017
RATING_DB_URL=ms_mongo_db_rating:27017

# ── Redis (every instance listens on 6379 inside the network) ──
REDIS_PORT=6379
REDIS_HOST=redis
REDIS_INVENTORY_HOST=redis_inventory
REDIS_ORDER_HOST=redis_order
REDIS_PAYMENT_HOST=ms_redis_payment
REDIS_PRODUCT_HOST=ms_redis

# ── Cloudinary (media storage) ──
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=CHANGE-ME
CLOUDINARY_API_SECRET=CHANGE-ME

# ── PayOS (payments) ──
PAYOS_CLIENT_ID=CHANGE-ME
PAYOS_API_KEY=CHANGE-ME
PAYOS_CHECKSUM_KEY=CHANGE-ME

# ── pgAdmin (optional — docker-compose.yml provides defaults) ──
# PGADMIN_DEFAULT_EMAIL=pgadmin4@pgadmin.org
# PGADMIN_DEFAULT_PASSWORD=admin

# ── ML server (backend/ml-service) ──
# By default recommendation-service calls an ML server running manually on the host.
# When running `docker compose --profile ml up`, change this to http://ml-service:9090
ML_SERVICE_URL=http://host.docker.internal:9090
